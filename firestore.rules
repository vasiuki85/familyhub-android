rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function memberDoc(familyId) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid);
    }

    function memberRole(familyId) {
      return get(memberDoc(familyId)).data.role;
    }

    function isActiveMember(familyId) {
      return isAuth()
        && exists(memberDoc(familyId))
        && memberRole(familyId) in ['ADMIN', 'PARENT', 'CHILD'];
    }

    function isAdmin(familyId) {
      return isActiveMember(familyId) && memberRole(familyId) == 'ADMIN';
    }

    function isAdminOrParent(familyId) {
      return isActiveMember(familyId) && memberRole(familyId) in ['ADMIN', 'PARENT'];
    }

    function validAvatarColor(color) {
      return color is string && color.matches('^#[0-9A-Fa-f]{6}$');
    }

    function validMember(memberId) {
      return request.resource.data.keys().hasAll(['id', 'role'])
        && request.resource.data.keys().hasOnly([
          'id', 'role', 'displayName', 'roleLabel', 'avatarColor',
          'birthDate', 'age', 'photoUrl'
        ])
        && request.resource.data.id is string
        && request.resource.data.id == memberId
        && request.resource.data.role in ['ADMIN', 'PARENT', 'CHILD', 'PENDING']
        && validAvatarColor(request.resource.data.avatarColor);
    }

    function canReadTask() {
      return !('private' in resource.data)
        || resource.data.private != true
        || resource.data.createdByUserId == request.auth.uid
        || resource.data.assignedToUserId == request.auth.uid;
    }

    function canReadFamilyGoal() {
      return !('personal' in resource.data)
        || resource.data.personal != true
        || resource.data.createdByUserId == request.auth.uid;
    }

    function canReadFamilyGoalChild(familyId, goalId) {
      let goal = get(/databases/$(database)/documents/families/$(familyId)/family_goals/$(goalId));
      return !('personal' in goal.data)
        || goal.data.personal != true
        || goal.data.createdByUserId == request.auth.uid;
    }

    function childCreateRewardPointsAllowed() {
      return !('rewardPoints' in request.resource.data)
        || request.resource.data.rewardPoints == null;
    }

    function parentRewardPointsAllowed() {
      return !('rewardPoints' in request.resource.data)
        || request.resource.data.rewardPoints == null
        || (request.resource.data.rewardPoints is int && request.resource.data.rewardPoints >= 0);
    }

    function validTaskCompletionCreate(docId) {
      return request.resource.data.id == docId
        && request.resource.data.taskId is string
        && request.resource.data.taskId.size() > 0
        && request.resource.data.completionCycle is int
        && request.resource.data.completionCycle >= 0;
    }

    function validTaskCompletionUpdate() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.taskId == resource.data.taskId
        && (
          (!('completionCycle' in resource.data) || resource.data.completionCycle == null)
            ? (
              !('completionCycle' in request.resource.data)
              || request.resource.data.completionCycle == null
            )
            : (
              request.resource.data.completionCycle == resource.data.completionCycle
              && request.resource.data.completionCycle is int
              && request.resource.data.completionCycle >= 0
            )
        );
    }

    function validCompletionCycleField(data) {
      return !('completionCycle' in data)
        || data.completionCycle == null
        || (data.completionCycle is int && data.completionCycle >= 0);
    }

    function taskCreateCompletionCycleAllowed() {
      return !('completionCycle' in request.resource.data)
        || request.resource.data.completionCycle == 0;
    }

    function taskUpdateCompletionCycleAllowed() {
      let previousCycle = !('completionCycle' in resource.data) ? 0 : resource.data.completionCycle;
      let nextCycle = !('completionCycle' in request.resource.data) ? previousCycle : request.resource.data.completionCycle;
      return nextCycle >= previousCycle;
    }

    function canCreateTask(familyId) {
      return request.resource.data.createdByUserId == request.auth.uid
        && validCompletionCycleField(request.resource.data)
        && taskCreateCompletionCycleAllowed()
        && (
          (isAdminOrParent(familyId) && parentRewardPointsAllowed())
          || (
            memberRole(familyId) == 'CHILD'
            && request.resource.data.status == 'TODO'
            && request.resource.data.assignedToUserId == request.auth.uid
            && childCreateRewardPointsAllowed()
          )
        );
    }

    function childAssigneeStatusTransition(familyId) {
      return memberRole(familyId) == 'CHILD'
        && resource.data.assignedToUserId == request.auth.uid
        && request.resource.data.status != 'DONE'
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'requiresApproval'])
            && request.resource.data.status == 'WAITING_FOR_APPROVAL'
            && request.resource.data.requiresApproval == true
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'TODO'
            && resource.data.status == 'WAITING_FOR_APPROVAL'
            && resource.data.requiresApproval == true
            && request.resource.data.requiresApproval == resource.data.requiresApproval
          )
        );
    }

    function childCreatorCanUpdateTask(familyId) {
      return memberRole(familyId) == 'CHILD'
        && resource.data.createdByUserId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'createdByUserId', 'assignedToUserId', 'rewardPoints', 'private',
            'status', 'requiresApproval', 'completionCycle'
          ]);
    }

    function parentTaskInvariants() {
      return parentRewardPointsAllowed()
        && validCompletionCycleField(request.resource.data)
        && taskUpdateCompletionCycleAllowed();
    }

    function canUpdateTask(familyId) {
      return (
          (isAdminOrParent(familyId) && parentTaskInvariants())
        || childAssigneeStatusTransition(familyId)
        || childCreatorCanUpdateTask(familyId)
        || (
          resource.data.createdByUserId == request.auth.uid
          && memberRole(familyId) != 'CHILD'
          && parentTaskInvariants()
        )
      );
    }

    function canDeleteTask(familyId) {
      return isAdminOrParent(familyId)
        || resource.data.createdByUserId == request.auth.uid;
    }

    function validRewardCost(cost) {
      return cost is int && cost >= 0;
    }

    function rewardRequestProcessedFieldsAbsent() {
      return (!('processedAt' in request.resource.data) || request.resource.data.processedAt == null)
        && (!('processedByUserId' in request.resource.data) || request.resource.data.processedByUserId == null);
    }

    function rewardRequestIdentityImmutable() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.rewardId == resource.data.rewardId
        && request.resource.data.rewardTitle == resource.data.rewardTitle
        && request.resource.data.rewardCost == resource.data.rewardCost
        && request.resource.data.requesterUserId == resource.data.requesterUserId
        && request.resource.data.requestedAt == resource.data.requestedAt
        && (
          !('note' in resource.data)
            ? !('note' in request.resource.data)
            : ('note' in request.resource.data)
              && request.resource.data.note == resource.data.note
        );
    }

    function rewardRequestHasProcessedAt(data) {
      return 'processedAt' in data && data.processedAt is int;
    }

    function rewardRequestIsKnownStatus(status) {
      return status == 'PENDING' || status == 'APPROVED' || status == 'DECLINED';
    }

    function rewardRequestProcessedAtMonotonic() {
      return !rewardRequestHasProcessedAt(resource.data)
        || request.resource.data.processedAt >= resource.data.processedAt;
    }

    function validRewardRequestStatusTransition(fromStatus, toStatus) {
      return (fromStatus == 'PENDING' && (toStatus == 'APPROVED' || toStatus == 'DECLINED'))
        || (fromStatus == 'DECLINED' && toStatus == 'APPROVED')
        || (fromStatus == 'APPROVED' && toStatus == 'APPROVED')
        || (fromStatus == 'DECLINED' && toStatus == 'DECLINED');
    }

    function validRewardRequestUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'processedAt', 'processedByUserId'])
        && rewardRequestIdentityImmutable()
        && request.resource.data.processedByUserId == request.auth.uid
        && request.resource.data.processedAt is int
        && rewardRequestProcessedAtMonotonic()
        && validRewardRequestStatusTransition(resource.data.status, request.resource.data.status)
        && !(resource.data.status == 'APPROVED' && request.resource.data.status == 'DECLINED')
        && !(
          (resource.data.status == 'APPROVED' || resource.data.status == 'DECLINED')
          && request.resource.data.status == 'PENDING'
        )
        && (
          resource.data.status != request.resource.data.status
          || rewardRequestIsKnownStatus(resource.data.status)
        );
    }

    function validRewardRequestCreate(familyId, requestId) {
      let reward = get(
        /databases/$(database)/documents/families/$(familyId)/rewards/$(request.resource.data.rewardId)
      );
      return request.resource.data.requesterUserId == request.auth.uid
        && request.resource.data.id == requestId
        && request.resource.data.status == 'PENDING'
        && rewardRequestProcessedFieldsAbsent()
        && exists(
          /databases/$(database)/documents/families/$(familyId)/rewards/$(request.resource.data.rewardId)
        )
        && reward.data.title == request.resource.data.rewardTitle
        && request.resource.data.rewardCost is int
        && request.resource.data.rewardCost >= 0
        && reward.data.cost == request.resource.data.rewardCost
        && reward.data.active == true;
    }

    function validPenaltyAmount(amount) {
      return amount is int
        && amount >= -2147483647
        && amount <= -1;
    }

    function penaltyHasCanceledAt(data) {
      return 'canceledAt' in data && data.canceledAt is int;
    }

    function penaltyCanceledAtValidForActive(data) {
      return !('canceledAt' in data) || data.canceledAt == null;
    }

    function penaltyCanceledAtValidForCanceled(data) {
      return !('canceledAt' in data)
        || data.canceledAt == null
        || data.canceledAt is int;
    }

    function penaltyCommentAbsentNullOnly() {
      let oldEmpty = !('comment' in resource.data) || resource.data.comment == null;
      let newEmpty = !('comment' in request.resource.data) || request.resource.data.comment == null;
      return oldEmpty && newEmpty;
    }

    function penaltyOriginTypeAbsentNullOnly() {
      let oldEmpty = !('originType' in resource.data) || resource.data.originType == null;
      let newEmpty = !('originType' in request.resource.data) || request.resource.data.originType == null;
      return oldEmpty && newEmpty;
    }

    function penaltyOriginIdAbsentNullOnly() {
      let oldEmpty = !('originId' in resource.data) || resource.data.originId == null;
      let newEmpty = !('originId' in request.resource.data) || request.resource.data.originId == null;
      return oldEmpty && newEmpty;
    }

    function penaltyIdentityImmutable() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.issuedByUserId == resource.data.issuedByUserId
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (!('comment' in resource.data) || resource.data.comment == null)
            ? (!('comment' in request.resource.data) || request.resource.data.comment == null)
            : ('comment' in request.resource.data)
              && request.resource.data.comment == resource.data.comment
        )
        && (
          (!('originType' in resource.data) || resource.data.originType == null)
            ? (!('originType' in request.resource.data) || request.resource.data.originType == null)
            : ('originType' in request.resource.data)
              && request.resource.data.originType == resource.data.originType
        )
        && (
          (!('originId' in resource.data) || resource.data.originId == null)
            ? (!('originId' in request.resource.data) || request.resource.data.originId == null)
            : ('originId' in request.resource.data)
              && request.resource.data.originId == resource.data.originId
        );
    }

    function penaltyUpdateAffectedKeysValid() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['canceled', 'canceledAt', 'comment', 'originType', 'originId'])
        && (
          !affected.hasAny(['comment'])
          || penaltyCommentAbsentNullOnly()
        )
        && (
          !affected.hasAny(['originType'])
          || penaltyOriginTypeAbsentNullOnly()
        )
        && (
          !affected.hasAny(['originId'])
          || penaltyOriginIdAbsentNullOnly()
        );
    }

    function penaltyCanceledAtMonotonic() {
      return !penaltyHasCanceledAt(resource.data)
        || request.resource.data.canceledAt >= resource.data.canceledAt;
    }

    function validPenaltyCreate(docId) {
      return request.resource.data.id == docId
        && validPenaltyAmount(request.resource.data.amount)
        && request.resource.data.canceled is bool
        && (
          !request.resource.data.canceled
            ? penaltyCanceledAtValidForActive(request.resource.data)
            : penaltyCanceledAtValidForCanceled(request.resource.data)
        );
    }

    function validPenaltyStatusTransition() {
      return (!resource.data.canceled && request.resource.data.canceled)
        || (resource.data.canceled && request.resource.data.canceled);
    }

    function validPenaltyCanceledAtOnUpdate() {
      return request.resource.data.canceled
        && request.resource.data.canceledAt is int;
    }

    function validPenaltyUpdate() {
      return penaltyUpdateAffectedKeysValid()
        && penaltyIdentityImmutable()
        && validPenaltyStatusTransition()
        && !(resource.data.canceled && !request.resource.data.canceled)
        && validPenaltyCanceledAtOnUpdate()
        && penaltyCanceledAtMonotonic();
    }

    function validFirestoreDocumentId(id) {
      return id is string
        && id.size() > 0
        && id != '.'
        && id != '..'
        && !id.matches('.*[/].*')
        && !(id.size() >= 4 && id.matches('^__.*__$'));
    }

    function validMealType(mealType) {
      return mealType is string
        && mealType in ['BREAKFAST', 'LUNCH', 'DINNER', 'SNACK'];
    }

    function validDayOfWeek(dayOfWeek) {
      return dayOfWeek is int && dayOfWeek >= 0 && dayOfWeek <= 6;
    }

    function validServings(servings) {
      return servings is int && servings >= 1 && servings <= 99;
    }

    function validNonNegativeTimestamp(value) {
      return value is int && value >= 0;
    }

    function validUpdatedAtField(data) {
      return validNonNegativeTimestamp(data.updatedAt);
    }

    function validUpdatedAtMonotonic() {
      return request.resource.data.updatedAt >= resource.data.updatedAt;
    }

    function optionalReferenceId(data, key) {
      return !data.keys().hasAny([key])
        || data[key] == null
        || (data[key] is string
          && data[key].size() > 0
          && validFirestoreDocumentId(data[key]));
    }

    function optionalStringField(data, key) {
      return !data.keys().hasAny([key]) || data[key] == null || data[key] is string;
    }

    function optionalExactIntField(data, key) {
      return !data.keys().hasAny([key]) || data[key] == null || data[key] is int;
    }

    function validWeeklyMenuKeys(data) {
      return data.keys().hasOnly([
        'id', 'startDateMillis', 'isAutoGenerated', 'createdAt', 'updatedAt',
      ]);
    }

    function validWeeklyMenuCreate(docId) {
      return validWeeklyMenuKeys(request.resource.data)
        && request.resource.data.keys().hasAll([
          'id', 'startDateMillis', 'isAutoGenerated', 'createdAt', 'updatedAt',
        ])
        && request.resource.data.id == docId
        && validFirestoreDocumentId(request.resource.data.id)
        && validNonNegativeTimestamp(request.resource.data.startDateMillis)
        && request.resource.data.isAutoGenerated is bool
        && validNonNegativeTimestamp(request.resource.data.createdAt)
        && validUpdatedAtField(request.resource.data);
    }

    function validWeeklyMenuUpdate(docId) {
      return validWeeklyMenuKeys(request.resource.data)
        && request.resource.data.keys().hasAll([
          'id', 'startDateMillis', 'isAutoGenerated', 'createdAt', 'updatedAt',
        ])
        && request.resource.data.id == docId
        && validFirestoreDocumentId(request.resource.data.id)
        && request.resource.data.id == resource.data.id
        && request.resource.data.startDateMillis == resource.data.startDateMillis
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.isAutoGenerated is bool
        && validUpdatedAtField(request.resource.data)
        && validUpdatedAtMonotonic();
    }

    function validMenuEntryKeys(data) {
      return data.keys().hasOnly([
        'id', 'menuId', 'dayOfWeek', 'mealType', 'servings', 'updatedAt',
        'recipeId', 'customDish', 'assignedMemberId', 'cookingTaskId', 'prepTaskId',
      ]);
    }

    function validMenuEntryOptionalFields(data) {
      return optionalReferenceId(data, 'recipeId')
        && optionalStringField(data, 'customDish')
        && optionalReferenceId(data, 'assignedMemberId')
        && optionalReferenceId(data, 'cookingTaskId')
        && optionalReferenceId(data, 'prepTaskId');
    }

    function validMenuEntryCreate(docId) {
      return validMenuEntryKeys(request.resource.data)
        && request.resource.data.keys().hasAll([
          'id', 'menuId', 'dayOfWeek', 'mealType', 'servings', 'updatedAt',
        ])
        && request.resource.data.id == docId
        && validFirestoreDocumentId(request.resource.data.id)
        && validFirestoreDocumentId(request.resource.data.menuId)
        && validDayOfWeek(request.resource.data.dayOfWeek)
        && validMealType(request.resource.data.mealType)
        && validServings(request.resource.data.servings)
        && validUpdatedAtField(request.resource.data)
        && validMenuEntryOptionalFields(request.resource.data);
    }

    function validMenuEntryUpdate(docId) {
      return validMenuEntryKeys(request.resource.data)
        && request.resource.data.keys().hasAll([
          'id', 'menuId', 'dayOfWeek', 'mealType', 'servings', 'updatedAt',
        ])
        && request.resource.data.id == docId
        && validFirestoreDocumentId(request.resource.data.id)
        && request.resource.data.id == resource.data.id
        && request.resource.data.menuId == resource.data.menuId
        && request.resource.data.dayOfWeek == resource.data.dayOfWeek
        && request.resource.data.mealType == resource.data.mealType
        && validServings(request.resource.data.servings)
        && validUpdatedAtField(request.resource.data)
        && validUpdatedAtMonotonic()
        && validMenuEntryOptionalFields(request.resource.data);
    }

    function validMenuTemplateKeys(data) {
      return data.keys().hasOnly(['id', 'name', 'createdAt', 'updatedAt']);
    }

    function validMenuTemplateCreate(docId) {
      return validMenuTemplateKeys(request.resource.data)
        && request.resource.data.keys().hasAll(['id', 'name', 'createdAt', 'updatedAt'])
        && request.resource.data.id == docId
        && validFirestoreDocumentId(request.resource.data.id)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && validNonNegativeTimestamp(request.resource.data.createdAt)
        && validUpdatedAtField(request.resource.data);
    }

    function validMenuTemplateUpdate(docId) {
      return validMenuTemplateKeys(request.resource.data)
        && request.resource.data.keys().hasAll(['id', 'name', 'createdAt', 'updatedAt'])
        && request.resource.data.id == docId
        && validFirestoreDocumentId(request.resource.data.id)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && validUpdatedAtField(request.resource.data)
        && validUpdatedAtMonotonic();
    }

    function validMenuTemplateEntryKeys(data) {
      return data.keys().hasOnly([
        'id', 'templateId', 'dayOfWeek', 'mealType', 'servings', 'updatedAt',
        'recipeId', 'customDish', 'assignedMemberId', 'cookingTaskId', 'prepTaskId',
      ]);
    }

    function validMenuTemplateEntryOptionalFields(data) {
      return optionalReferenceId(data, 'recipeId')
        && optionalStringField(data, 'customDish')
        && optionalReferenceId(data, 'assignedMemberId')
        && (!data.keys().hasAny(['cookingTaskId']) || data.cookingTaskId == null)
        && (!data.keys().hasAny(['prepTaskId']) || data.prepTaskId == null);
    }

    function validMenuTemplateEntryCreate(docId) {
      return validMenuTemplateEntryKeys(request.resource.data)
        && request.resource.data.keys().hasAll([
          'id', 'templateId', 'dayOfWeek', 'mealType', 'servings', 'updatedAt',
        ])
        && request.resource.data.id == docId
        && validFirestoreDocumentId(request.resource.data.id)
        && validFirestoreDocumentId(request.resource.data.templateId)
        && validDayOfWeek(request.resource.data.dayOfWeek)
        && validMealType(request.resource.data.mealType)
        && validServings(request.resource.data.servings)
        && validUpdatedAtField(request.resource.data)
        && validMenuTemplateEntryOptionalFields(request.resource.data);
    }

    function validMenuTemplateEntryUpdate(docId) {
      return validMenuTemplateEntryKeys(request.resource.data)
        && request.resource.data.keys().hasAll([
          'id', 'templateId', 'dayOfWeek', 'mealType', 'servings', 'updatedAt',
        ])
        && request.resource.data.id == docId
        && validFirestoreDocumentId(request.resource.data.id)
        && request.resource.data.id == resource.data.id
        && request.resource.data.templateId == resource.data.templateId
        && request.resource.data.dayOfWeek == resource.data.dayOfWeek
        && request.resource.data.mealType == resource.data.mealType
        && validServings(request.resource.data.servings)
        && validUpdatedAtField(request.resource.data)
        && validUpdatedAtMonotonic()
        && validMenuTemplateEntryOptionalFields(request.resource.data);
    }

    function validDailyAssignmentKeys(data) {
      return data.keys().hasOnly([
        'id', 'weekStartMillis', 'dayOfWeek', 'isRated', 'updatedAt',
        'assignedMemberId', 'rewardPoints',
      ]);
    }

    function validDailyAssignmentOptionalFields(data) {
      return optionalReferenceId(data, 'assignedMemberId')
        && optionalExactIntField(data, 'rewardPoints');
    }

    function validDailyAssignmentCreate(docId) {
      return validDailyAssignmentKeys(request.resource.data)
        && request.resource.data.keys().hasAll([
          'id', 'weekStartMillis', 'dayOfWeek', 'isRated', 'updatedAt',
        ])
        && request.resource.data.id == docId
        && validFirestoreDocumentId(request.resource.data.id)
        && validNonNegativeTimestamp(request.resource.data.weekStartMillis)
        && validDayOfWeek(request.resource.data.dayOfWeek)
        && request.resource.data.isRated is bool
        && validUpdatedAtField(request.resource.data)
        && validDailyAssignmentOptionalFields(request.resource.data);
    }

    function validDailyAssignmentUpdate(docId) {
      return validDailyAssignmentKeys(request.resource.data)
        && request.resource.data.keys().hasAll([
          'id', 'weekStartMillis', 'dayOfWeek', 'isRated', 'updatedAt',
        ])
        && request.resource.data.id == docId
        && validFirestoreDocumentId(request.resource.data.id)
        && request.resource.data.id == resource.data.id
        && request.resource.data.weekStartMillis == resource.data.weekStartMillis
        && request.resource.data.dayOfWeek == resource.data.dayOfWeek
        && request.resource.data.isRated is bool
        && validUpdatedAtField(request.resource.data)
        && validUpdatedAtMonotonic()
        && validDailyAssignmentOptionalFields(request.resource.data);
    }

    function canWriteMenu(familyId) {
      return isAdminOrParent(familyId);
    }

    match /families/{familyId} {
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid is string;
      allow read: if isActiveMember(familyId);
      allow update: if isActiveMember(familyId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['ownerUid', 'members']);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isActiveMember(familyId)
          || (isAuth() && request.auth.uid == memberId);

        allow create: if validMember(memberId) && (
          (isAdmin(familyId) && request.resource.data.role != 'ADMIN')
          || (isAuth()
            && request.auth.uid == memberId
            && request.resource.data.role == 'PENDING'
            && exists(/databases/$(database)/documents/families/$(familyId)))
          || (isAuth()
            && request.auth.uid == memberId
            && request.resource.data.role == 'ADMIN'
            && getAfter(/databases/$(database)/documents/families/$(familyId)).data.ownerUid
              == request.auth.uid)
        );

        allow update: if validMember(memberId) && (
          (isAdmin(familyId)
            && ((resource.data.role == 'ADMIN' && request.resource.data.role == 'ADMIN')
              || (resource.data.role != 'ADMIN' && request.resource.data.role != 'ADMIN')))
          || (isAuth()
            && request.auth.uid == memberId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'roleLabel', 'avatarColor', 'birthDate', 'age', 'photoUrl'
            ]))
        );

        allow delete: if resource.data.role != 'ADMIN'
          && (isAdmin(familyId) || (isAuth() && request.auth.uid == memberId));
      }

      match /tasks/{taskId} {
        allow read: if isActiveMember(familyId) && canReadTask();
        allow create: if isActiveMember(familyId) && canCreateTask(familyId);
        allow update: if isActiveMember(familyId) && canUpdateTask(familyId);
        allow delete: if isActiveMember(familyId) && canDeleteTask(familyId);
      }

      match /shopping_lists/{docId} {
        allow read, create, update, delete: if isActiveMember(familyId);
      }

      match /shopping_categories/{docId} {
        allow read, create, update, delete: if isActiveMember(familyId);
      }

      match /shopping_items/{docId} {
        allow read, create, update, delete: if isActiveMember(familyId);
      }

      match /shopping_activity/{docId} {
        allow read, create, update, delete: if isActiveMember(familyId);
      }

      match /events/{docId} {
        allow read, create, update, delete: if isActiveMember(familyId);
      }

      match /scores/{docId} {
        allow read: if isActiveMember(familyId);
        allow create, update, delete: if isAdminOrParent(familyId);
      }

      match /task_completions/{docId} {
        allow read: if isActiveMember(familyId);
        allow create: if isAdminOrParent(familyId) && validTaskCompletionCreate(docId);
        allow update: if isAdminOrParent(familyId) && validTaskCompletionUpdate();
        allow delete: if isAdminOrParent(familyId);
      }

      match /achievements/{docId} {
        allow read: if isActiveMember(familyId);
        allow create, update, delete: if isAdminOrParent(familyId);
      }

      match /wallets/{docId} {
        allow read: if isActiveMember(familyId);
        allow create, update, delete: if isAdminOrParent(familyId);
      }

      match /penalties/{docId} {
        allow read: if isActiveMember(familyId);
        allow create: if isAdminOrParent(familyId)
          && validPenaltyCreate(docId);
        allow update: if isAdminOrParent(familyId)
          && validPenaltyUpdate();
        allow delete: if false;
      }

      match /rewards/{docId} {
        allow read: if isActiveMember(familyId);
        allow create: if isAdminOrParent(familyId)
          && validRewardCost(request.resource.data.cost);
        allow update: if isAdminOrParent(familyId)
          && validRewardCost(request.resource.data.cost);
        allow delete: if isAdminOrParent(familyId);
      }

      match /reward_requests/{requestId} {
        allow read: if isActiveMember(familyId);
        allow create: if isActiveMember(familyId)
          && validRewardRequestCreate(familyId, requestId);
        allow update: if isAdminOrParent(familyId)
          && validRewardRequestUpdate();
        allow delete: if false;
      }

      match /task_rotations/{docId} {
        allow read: if isActiveMember(familyId);
        allow create, update, delete: if isAdminOrParent(familyId);
      }

      match /house_rules/{docId} {
        allow read: if isActiveMember(familyId);
        allow create, update, delete: if isAdminOrParent(familyId);
      }

      match /task_templates/{docId} {
        allow read: if isActiveMember(familyId);
        allow create, update, delete: if isAdminOrParent(familyId);
      }

      match /task_categories/{docId} {
        allow read: if isActiveMember(familyId);
        allow create, update, delete: if isAdminOrParent(familyId);
      }

      match /appreciations/{docId} {
        allow read, create, update, delete: if isActiveMember(familyId);
      }

      match /family_goals/{goalId} {
        allow read: if isActiveMember(familyId) && canReadFamilyGoal();
        allow create: if isActiveMember(familyId)
          && (isAdminOrParent(familyId)
            || request.resource.data.createdByUserId == request.auth.uid);
        allow update, delete: if isActiveMember(familyId)
          && (isAdminOrParent(familyId)
            || resource.data.createdByUserId == request.auth.uid);
      }

      match /family_goal_stages/{stageId} {
        allow read: if isActiveMember(familyId)
          && canReadFamilyGoalChild(familyId, resource.data.goalId);
        allow create: if isActiveMember(familyId)
          && canReadFamilyGoalChild(familyId, request.resource.data.goalId);
        allow update, delete: if isActiveMember(familyId)
          && canReadFamilyGoalChild(familyId, resource.data.goalId);
      }

      match /family_goal_steps/{stepId} {
        allow read: if isActiveMember(familyId)
          && canReadFamilyGoalChild(familyId, resource.data.goalId);
        allow create: if isActiveMember(familyId)
          && canReadFamilyGoalChild(familyId, request.resource.data.goalId);
        allow update, delete: if isActiveMember(familyId)
          && canReadFamilyGoalChild(familyId, resource.data.goalId);
      }

      match /emergency_contacts/{docId} {
        allow read: if isActiveMember(familyId);
        allow create, update, delete: if isAdminOrParent(familyId);
      }

      match /recipes/{docId} {
        allow read, create, update, delete: if isActiveMember(familyId);
      }

      match /weekly_menus/{docId} {
        allow read: if isActiveMember(familyId);
        allow create: if canWriteMenu(familyId) && validWeeklyMenuCreate(docId);
        allow update: if canWriteMenu(familyId) && validWeeklyMenuUpdate(docId);
        allow delete: if canWriteMenu(familyId);
      }

      match /menu_entries/{docId} {
        allow read: if isActiveMember(familyId);
        allow create: if canWriteMenu(familyId) && validMenuEntryCreate(docId);
        allow update: if canWriteMenu(familyId) && validMenuEntryUpdate(docId);
        allow delete: if canWriteMenu(familyId);
      }

      match /menu_templates/{docId} {
        allow read: if isActiveMember(familyId);
        allow create: if canWriteMenu(familyId) && validMenuTemplateCreate(docId);
        allow update: if canWriteMenu(familyId) && validMenuTemplateUpdate(docId);
        allow delete: if canWriteMenu(familyId);
      }

      match /menu_template_entries/{docId} {
        allow read: if isActiveMember(familyId);
        allow create: if canWriteMenu(familyId) && validMenuTemplateEntryCreate(docId);
        allow update: if canWriteMenu(familyId) && validMenuTemplateEntryUpdate(docId);
        allow delete: if canWriteMenu(familyId);
      }

      match /daily_assignments/{docId} {
        allow read: if isActiveMember(familyId);
        allow create: if canWriteMenu(familyId) && validDailyAssignmentCreate(docId);
        allow update: if canWriteMenu(familyId) && validDailyAssignmentUpdate(docId);
        allow delete: if canWriteMenu(familyId);
      }

      match /push_events/{eventId} {
        allow read, write: if false;
      }

      match /sync_triggers/{triggerId} {
        allow read: if isActiveMember(familyId);
        allow create: if isActiveMember(familyId)
          && request.resource.data.keys().hasAll(['deviceId'])
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.size() > 0
          && request.resource.data.deviceId.size() <= 200;
        allow update: if false;
        allow delete: if isActiveMember(familyId);
      }
    }
  }
}
